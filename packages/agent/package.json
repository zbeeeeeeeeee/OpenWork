{
  "name": "@openwork/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone agent framework for OpenWork - LLM provider, agent loop, and tool execution",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "require": "./dist/sanitize.js",
      "default": "./dist/sanitize.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "smoke:fc": "node scripts/smoke-fc.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.0.0"
  }
}
